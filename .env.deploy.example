# Non-production single-host staging example. Copy to .env.deploy and replace secrets.
COMPOSE_PROJECT_NAME=watchtower-staging
WATCHTOWER_IMAGE_TAG=local
WATCHTOWER_BIND_PORT=8000

POSTGRES_DB=watchtower
POSTGRES_USER=watchtower
POSTGRES_PASSWORD=replace-with-a-long-random-staging-password

WATCHTOWER_DATABASE_URL=postgresql+psycopg://watchtower:replace-with-a-long-random-staging-password@postgres:5432/watchtower
WATCHTOWER_ENVIRONMENT=staging
WATCHTOWER_LOG_LEVEL=INFO
WATCHTOWER_DB_CONNECT_TIMEOUT=3
WATCHTOWER_DB_POOL_TIMEOUT=3
WATCHTOWER_DB_POOL_SIZE=5
WATCHTOWER_DB_MAX_OVERFLOW=5
WATCHTOWER_DB_POOL_RECYCLE_SECONDS=1800
WATCHTOWER_DB_STATEMENT_TIMEOUT_MS=3000
WATCHTOWER_RESPONSE_GZIP_MINIMUM_SIZE=1024
WATCHTOWER_RESPONSE_GZIP_COMPRESSLEVEL=5
WATCHTOWER_API_SLOW_REQUEST_MS=500
WATCHTOWER_MAX_REQUEST_BODY_BYTES=65536
WATCHTOWER_RAW_STORAGE_PATH=/var/lib/watchtower/raw
WATCHTOWER_MAX_RAW_EVIDENCE_BYTES=10485760
WATCHTOWER_REDIS_URL=redis://redis:6379/0
WATCHTOWER_OPERATOR_TOKEN=replace-with-at-least-32-random-characters
WATCHTOWER_INGESTION_JOB_MAX_ATTEMPTS=3
WATCHTOWER_INGESTION_JOB_LEASE_SECONDS=300
WATCHTOWER_INGESTION_JOB_TIMEOUT_SECONDS=240
WATCHTOWER_INGESTION_JOB_RETRY_BASE_SECONDS=5
WATCHTOWER_INGESTION_MAX_ACTIVE_JOBS=1000
WATCHTOWER_INGESTION_RECOVERY_BATCH_SIZE=100
WATCHTOWER_INGESTION_WORKER_PROCESSES=1
WATCHTOWER_INGESTION_WORKER_THREADS=2
WATCHTOWER_INGESTION_FETCH_TIMEOUT_SECONDS=30
WATCHTOWER_INGESTION_FETCH_CONNECT_TIMEOUT_SECONDS=10
WATCHTOWER_RAG_ENABLED=false
WATCHTOWER_RAG_CONTEXT_TOKEN_BUDGET=4000
WATCHTOWER_RAG_RETRIEVAL_LIMIT=12
WATCHTOWER_RAG_MAX_COSINE_DISTANCE=0.45
