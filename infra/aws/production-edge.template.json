{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Validation-only WATCHTOWER production identity and HTTPS edge baseline.",
  "Parameters": {
    "VpcId": { "Type": "AWS::EC2::VPC::Id" },
    "PublicSubnetIds": { "Type": "List<AWS::EC2::Subnet::Id>" },
    "ApplicationSecurityGroupId": { "Type": "AWS::EC2::SecurityGroup::Id" },
    "ApiInstanceId": { "Type": "AWS::EC2::Instance::Id" },
    "CertificateArn": {
      "Type": "String",
      "AllowedPattern": "^arn:[^:]+:acm:[^:]+:[0-9]{12}:certificate/[0-9a-fA-F-]+$"
    },
    "ApiHostname": {
      "Type": "String",
      "AllowedPattern": "^(?=.{1,253}$)(?!-)[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$"
    },
    "ApiPort": { "Type": "Number", "Default": 8000, "MinValue": 1, "MaxValue": 65535 },
    "AlbIngressIpv4Cidr": {
      "Type": "String",
      "Default": "0.0.0.0/0",
      "AllowedPattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[0-9]|[12][0-9]|3[0-2])$"
    },
    "PublicRateLimit": {
      "Type": "Number",
      "MinValue": 100,
      "Description": "Measured five-minute per-IP request limit for non-operator routes. No default is intentional."
    },
    "OperatorRateLimit": {
      "Type": "Number",
      "MinValue": 10,
      "Description": "Measured five-minute per-IP request limit for /api/v1/operations/. No default is intentional."
    },
    "AccessTokenMinutes": { "Type": "Number", "Default": 15, "MinValue": 5, "MaxValue": 60 },
    "RefreshTokenDays": { "Type": "Number", "Default": 1, "MinValue": 1, "MaxValue": 30 },
    "AlbLogRetentionDays": {
      "Type": "Number",
      "Default": 90,
      "AllowedValues": [30, 60, 90, 120, 180, 365]
    },
    "WafLogRetentionDays": {
      "Type": "Number",
      "Default": 90,
      "AllowedValues": [30, 60, 90, 120, 180, 365]
    }
  },
  "Resources": {
    "OperatorUserPool": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [{ "Name": "verified_email", "Priority": 1 }]
        },
        "AdminCreateUserConfig": { "AllowAdminCreateUserOnly": true },
        "AutoVerifiedAttributes": ["email"],
        "DeletionProtection": "ACTIVE",
        "EnabledMfas": ["SOFTWARE_TOKEN_MFA"],
        "MfaConfiguration": "ON",
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 14,
            "RequireLowercase": true,
            "RequireNumbers": true,
            "RequireSymbols": true,
            "RequireUppercase": true,
            "TemporaryPasswordValidityDays": 1
          }
        },
        "UserPoolName": "watchtower-production-operators",
        "UsernameAttributes": ["email"],
        "UserPoolTags": { "watchtower-boundary": "production-identity" }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "OperatorUserPoolClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "AccessTokenValidity": { "Ref": "AccessTokenMinutes" },
        "AllowedOAuthFlowsUserPoolClient": false,
        "EnableTokenRevocation": true,
        "ExplicitAuthFlows": ["ALLOW_USER_SRP_AUTH", "ALLOW_REFRESH_TOKEN_AUTH"],
        "GenerateSecret": false,
        "IdTokenValidity": { "Ref": "AccessTokenMinutes" },
        "PreventUserExistenceErrors": "ENABLED",
        "RefreshTokenValidity": { "Ref": "RefreshTokenDays" },
        "TokenValidityUnits": {
          "AccessToken": "minutes",
          "IdToken": "minutes",
          "RefreshToken": "days"
        },
        "UserPoolId": { "Ref": "OperatorUserPool"
        }
      }
    },
    "OperatorGroup": {
      "Type": "AWS::Cognito::UserPoolGroup",
      "Properties": {
        "Description": "WATCHTOWER protected-route operators",
        "GroupName": "operator",
        "Precedence": 20,
        "UserPoolId": { "Ref": "OperatorUserPool" }
      }
    },
    "PublisherGroup": {
      "Type": "AWS::Cognito::UserPoolGroup",
      "Properties": {
        "Description": "WATCHTOWER advisory publishers; members must also belong to operator",
        "GroupName": "publisher",
        "Precedence": 10,
        "UserPoolId": { "Ref": "OperatorUserPool" }
      }
    },
    "AlbAccessLogBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            { "ServerSideEncryptionByDefault": { "SSEAlgorithm": "AES256" } }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "ExpirationInDays": { "Ref": "AlbLogRetentionDays" },
              "Id": "expire-access-logs",
              "Status": "Enabled"
            }
          ]
        },
        "OwnershipControls": { "Rules": [{ "ObjectOwnership": "BucketOwnerEnforced" }] },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "AlbAccessLogBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": { "Ref": "AlbAccessLogBucket" },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowAlbLogDelivery",
              "Effect": "Allow",
              "Principal": { "Service": "logdelivery.elasticloadbalancing.amazonaws.com" },
              "Action": "s3:PutObject",
              "Resource": { "Fn::Sub": "${AlbAccessLogBucket.Arn}/AWSLogs/${AWS::AccountId}/*" },
              "Condition": {
                "ArnLike": {
                  "aws:SourceArn": { "Fn::Sub": "arn:${AWS::Partition}:elasticloadbalancing:${AWS::Region}:${AWS::AccountId}:loadbalancer/app/*" }
                },
                "StringEquals": { "aws:SourceAccount": { "Ref": "AWS::AccountId" } }
              }
            },
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                { "Fn::GetAtt": ["AlbAccessLogBucket", "Arn"] },
                { "Fn::Sub": "${AlbAccessLogBucket.Arn}/*" }
              ],
              "Condition": { "Bool": { "aws:SecureTransport": "false" } }
            }
          ]
        }
      }
    },
    "AlbSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "WATCHTOWER public ALB ingress and API-only egress",
        "SecurityGroupEgress": [
          {
            "DestinationSecurityGroupId": { "Ref": "ApplicationSecurityGroupId" },
            "FromPort": { "Ref": "ApiPort" },
            "IpProtocol": "tcp",
            "ToPort": { "Ref": "ApiPort" }
          }
        ],
        "SecurityGroupIngress": [
          {
            "CidrIp": { "Ref": "AlbIngressIpv4Cidr" },
            "Description": "HTTP redirect only",
            "FromPort": 80,
            "IpProtocol": "tcp",
            "ToPort": 80
          },
          {
            "CidrIp": { "Ref": "AlbIngressIpv4Cidr" },
            "Description": "HTTPS API",
            "FromPort": 443,
            "IpProtocol": "tcp",
            "ToPort": 443
          }
        ],
        "VpcId": { "Ref": "VpcId" }
      }
    },
    "ApplicationIngressFromAlb": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "Description": "WATCHTOWER API traffic from the production ALB only",
        "FromPort": { "Ref": "ApiPort" },
        "GroupId": { "Ref": "ApplicationSecurityGroupId" },
        "IpProtocol": "tcp",
        "SourceSecurityGroupId": { "Ref": "AlbSecurityGroup" },
        "ToPort": { "Ref": "ApiPort" }
      }
    },
    "ApiTargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "HealthCheckEnabled": true,
        "HealthCheckIntervalSeconds": 30,
        "HealthCheckPath": "/ready",
        "HealthCheckProtocol": "HTTP",
        "HealthCheckTimeoutSeconds": 5,
        "HealthyThresholdCount": 2,
        "Matcher": { "HttpCode": "200" },
        "Port": { "Ref": "ApiPort" },
        "Protocol": "HTTP",
        "TargetType": "instance",
        "Targets": [{ "Id": { "Ref": "ApiInstanceId" }, "Port": { "Ref": "ApiPort" } }],
        "UnhealthyThresholdCount": 2,
        "VpcId": { "Ref": "VpcId" }
      }
    },
    "ApiLoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "DependsOn": "AlbAccessLogBucketPolicy",
      "Properties": {
        "IpAddressType": "ipv4",
        "LoadBalancerAttributes": [
          { "Key": "deletion_protection.enabled", "Value": "true" },
          { "Key": "access_logs.s3.enabled", "Value": "true" },
          { "Key": "access_logs.s3.bucket", "Value": { "Ref": "AlbAccessLogBucket" } },
          { "Key": "routing.http.drop_invalid_header_fields.enabled", "Value": "true" },
          { "Key": "routing.http.desync_mitigation_mode", "Value": "strictest" },
          { "Key": "routing.http.xff_header_processing.mode", "Value": "append" },
          { "Key": "routing.http.preserve_host_header.enabled", "Value": "true" }
        ],
        "Scheme": "internet-facing",
        "SecurityGroups": [{ "Ref": "AlbSecurityGroup" }],
        "Subnets": { "Ref": "PublicSubnetIds" },
        "Type": "application"
      }
    },
    "HttpListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "DefaultActions": [
          {
            "RedirectConfig": { "Port": "443", "Protocol": "HTTPS", "StatusCode": "HTTP_301" },
            "Type": "redirect"
          }
        ],
        "LoadBalancerArn": { "Ref": "ApiLoadBalancer" },
        "Port": 80,
        "Protocol": "HTTP"
      }
    },
    "HttpsListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "Certificates": [{ "CertificateArn": { "Ref": "CertificateArn" } }],
        "DefaultActions": [
          { "ForwardConfig": { "TargetGroups": [{ "TargetGroupArn": { "Ref": "ApiTargetGroup" }, "Weight": 1 }] }, "Type": "forward" }
        ],
        "LoadBalancerArn": { "Ref": "ApiLoadBalancer" },
        "Port": 443,
        "Protocol": "HTTPS",
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06"
      }
    },
    "ApiWebAcl": {
      "Type": "AWS::WAFv2::WebACL",
      "Properties": {
        "DefaultAction": { "Allow": {} },
        "Description": "WATCHTOWER managed protections and measured per-IP rate limits",
        "Name": "watchtower-production-edge",
        "Rules": [
          {
            "Name": "AwsManagedCommon",
            "OverrideAction": { "None": {} },
            "Priority": 0,
            "Statement": {
              "ManagedRuleGroupStatement": { "Name": "AWSManagedRulesCommonRuleSet", "VendorName": "AWS" }
            },
            "VisibilityConfig": { "CloudWatchMetricsEnabled": true, "MetricName": "managed-common", "SampledRequestsEnabled": false }
          },
          {
            "Name": "AwsManagedKnownBadInputs",
            "OverrideAction": { "None": {} },
            "Priority": 1,
            "Statement": {
              "ManagedRuleGroupStatement": { "Name": "AWSManagedRulesKnownBadInputsRuleSet", "VendorName": "AWS" }
            },
            "VisibilityConfig": { "CloudWatchMetricsEnabled": true, "MetricName": "managed-known-bad-inputs", "SampledRequestsEnabled": false }
          },
          {
            "Action": { "Block": {} },
            "Name": "OperatorRouteRateLimit",
            "Priority": 10,
            "Statement": {
              "RateBasedStatement": {
                "AggregateKeyType": "IP",
                "Limit": { "Ref": "OperatorRateLimit" },
                "ScopeDownStatement": {
                  "ByteMatchStatement": {
                    "FieldToMatch": { "UriPath": {} },
                    "PositionalConstraint": "STARTS_WITH",
                    "SearchString": "/api/v1/operations/",
                    "TextTransformations": [{ "Priority": 0, "Type": "NONE" }]
                  }
                }
              }
            },
            "VisibilityConfig": { "CloudWatchMetricsEnabled": true, "MetricName": "operator-rate-limit", "SampledRequestsEnabled": false }
          },
          {
            "Action": { "Block": {} },
            "Name": "PublicRouteRateLimit",
            "Priority": 20,
            "Statement": {
              "RateBasedStatement": {
                "AggregateKeyType": "IP",
                "Limit": { "Ref": "PublicRateLimit" },
                "ScopeDownStatement": {
                  "NotStatement": {
                    "Statement": {
                      "ByteMatchStatement": {
                        "FieldToMatch": { "UriPath": {} },
                        "PositionalConstraint": "STARTS_WITH",
                        "SearchString": "/api/v1/operations/",
                        "TextTransformations": [{ "Priority": 0, "Type": "NONE" }]
                      }
                    }
                  }
                }
              }
            },
            "VisibilityConfig": { "CloudWatchMetricsEnabled": true, "MetricName": "public-rate-limit", "SampledRequestsEnabled": false }
          }
        ],
        "Scope": "REGIONAL",
        "VisibilityConfig": { "CloudWatchMetricsEnabled": true, "MetricName": "watchtower-production-edge", "SampledRequestsEnabled": false }
      }
    },
    "ApiWebAclAssociation": {
      "Type": "AWS::WAFv2::WebACLAssociation",
      "Properties": {
        "ResourceArn": { "Ref": "ApiLoadBalancer" },
        "WebACLArn": { "Fn::GetAtt": ["ApiWebAcl", "Arn"] }
      }
    },
    "WafLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "aws-waf-logs-watchtower-production",
        "RetentionInDays": { "Ref": "WafLogRetentionDays" }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "WafLoggingConfiguration": {
      "Type": "AWS::WAFv2::LoggingConfiguration",
      "Properties": {
        "LogDestinationConfigs": [{ "Fn::GetAtt": ["WafLogGroup", "Arn"] }],
        "LoggingFilter": {
          "DefaultBehavior": "DROP",
          "Filters": [
            {
              "Behavior": "KEEP",
              "Conditions": [
                { "ActionCondition": { "Action": "BLOCK" } },
                { "ActionCondition": { "Action": "COUNT" } }
              ],
              "Requirement": "MEETS_ANY"
            }
          ]
        },
        "RedactedFields": [
          { "SingleHeader": { "Name": "authorization" } },
          { "SingleHeader": { "Name": "cookie" } }
        ],
        "ResourceArn": { "Fn::GetAtt": ["ApiWebAcl", "Arn"] }
      }
    }
  },
  "Outputs": {
    "AlbDnsName": { "Value": { "Fn::GetAtt": ["ApiLoadBalancer", "DNSName"] } },
    "AlbSecurityGroupId": { "Value": { "Ref": "AlbSecurityGroup" } },
    "ApiHostname": { "Value": { "Ref": "ApiHostname" } },
    "ApiTargetGroupArn": { "Value": { "Ref": "ApiTargetGroup" } },
    "CognitoClientId": { "Value": { "Ref": "OperatorUserPoolClient" } },
    "CognitoIssuer": {
      "Value": { "Fn::Sub": "https://cognito-idp.${AWS::Region}.${AWS::URLSuffix}/${OperatorUserPool}" }
    },
    "CognitoJwksUrl": {
      "Value": { "Fn::Sub": "https://cognito-idp.${AWS::Region}.${AWS::URLSuffix}/${OperatorUserPool}/.well-known/jwks.json" }
    },
    "CognitoUserPoolId": { "Value": { "Ref": "OperatorUserPool" } },
    "WafWebAclArn": { "Value": { "Fn::GetAtt": ["ApiWebAcl", "Arn"] } }
  }
}
